{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Island",
  "version": "0.1.0",
  "identifier": "com.island.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "zip"],
    "identifier": "com.island.app",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "Utility",
    "shortDescription": "Dynamic island overlay for Windows 11",
    "longDescription": "Island — плавающий оверлей-остров: уведомления, лончер, буфер обмена, скриншоты с OCR, ИИ-чат."
  }
}
